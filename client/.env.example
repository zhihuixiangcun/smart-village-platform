# ==================== API 配置 ====================

# API 基础地址
VITE_APP_BASE_API=http://localhost:3001

# API 前缀
VITE_API_PREFIX=/api

# ==================== 地图 API 配置 ====================

# 高德地图 API 配置
# 请在高德开放平台申请: https://console.amap.com/
VITE_AMAP_KEY=7da29ab1b7d58cd008724108da77545df
VITE_AMAP_SECURITY_KEY=296c3fd0c70b887b7c915b8fa1e9247d

# 百度地图 API 配置（可选）
VITE_BAIDU_MAP_AK=your_baidu_map_ak_here

# 腾讯地图 API 配置（可选）
VITE_TENCENT_MAP_KEY=your_tencent_map_key_here

# ==================== 开发环境配置 ====================

# 开发模式
VITE_APP_MODE=development

# 是否启用Mock数据
VITE_USE_MOCK=false

# 请求超时时间（毫秒）
VITE_REQUEST_TIMEOUT=15000

# ==================== 功能开关 ====================

# 启用性能监控
VITE_ENABLE_PERFORMANCE_MONITORING=true

# 启用错误追踪
VITE_ENABLE_ERROR_TRACKING=true

# 启用日志输出
VITE_ENABLE_LOGGING=true

# ==================== 第三方服务配置 ====================

# WebSocket 地址
VITE_WS_URL=ws://localhost:3001

# 文件上传大小限制（MB）
VITE_MAX_UPLOAD_SIZE=10
