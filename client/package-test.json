{
  "name": "smart-village-client-test",
  "version": "1.0.0",
  "description": "智慧乡村前端测试依赖",
  "private": true,
  "scripts": {
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:related": "vitest --related",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:visual": "playwright test --config playwright-visual.config.ts",
    "test:performance": "playwright test --config playwright-performance.config.ts",
    "test:accessibility": "playwright test --config playwright-accessibility.config.ts",
    "test:security": "playwright test --config playwright-security.config.ts",
    "test:component": "vitest --environment jsdom --config vitest-component.config.ts",
    "test:integration": "vitest --config vitest-integration.config.ts",
    "test:all": "npm run test:run && npm run test:e2e && npm run test:coverage",
    "test:ci": "vitest run --coverage --reporter=junit --reporter=json",
    "test:parallel": "vitest run --threads --maxWorkers=4",
    "test:sequential": "vitest run --no-threads",
    "test:debug": "node --inspect-brk node_modules/.bin/vitest run",
    "test:smoke": "vitest run --run src/smoke-tests/**/*",
    "test:regression": "vitest run --run src/regression-tests/**/*",
    "test:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:desktop": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:cross-browser": "playwright test --project=all",
    "test:lint": "eslint --ext .vue,.js,.ts src/ test/ e2e/ --fix",
    "test:lint:check": "eslint --ext .vue,.js,.ts src/ test/ e2e/",
    "type-check": "vue-tsc --noEmit",
    "test:validate": "npm run type-check && npm run test:lint:check",
    "prepare-test": "node test/scripts/prepare-test-env.js",
    "cleanup-test": "node test/scripts/cleanup-test-env.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/vue": "^8.0.1",
    "@testing-library/user-event": "^14.5.1",
    "@vitest/coverage-c8": "^0.34.6",
    "@vitest/ui": "^0.34.6",
    "@vue/test-utils": "^2.4.2",
    "axe-core": "^4.8.3",
    "c8": "^8.0.1",
    "cross-env": "^7.0.3",
    "happy-dom": "^12.10.3",
    "jsdom": "^23.0.1",
    "msw": "^2.0.8",
    "playwright": "^1.40.0",
    "playwright-ct-vue": "^0.12.0",
    "sinon": "^17.0.1",
    "vitest": "^0.34.6",
    "vue-tsc": "^1.8.22"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "vue": "^3.3.8",
    "vue-router": "^4.2.5"
  }
}