{
  "name": "smart-village-platform",
  "version": "1.0.0",
  "description": "智慧乡村综合服务平台 - 涵盖村民管理、村务治理、信息公示、生活服务四大核心模块",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "test:residents": "NODE_ENV=test jest test-resident-module.js",
    "verify:residents": "node run-resident-tests.js",
    "lint": "eslint src/ --fix",
    "init": "npm install && npm run setup",
    "setup": "node scripts/setup.js",
    "init-db": "node scripts/init-db.js",
    "init-db-sqlite": "node scripts/init-db-sqlite.js",
    "health-check": "node -e \"console.log('Node.js:', process.version); console.log('Platform:', process.platform);\""
  },
  "keywords": [
    "smart-village",
    "rural-services",
    "express",
    "vue",
    "nodejs",
    "智慧乡村"
  ],
  "author": "admin",
  "license": "ISC",
  "engines": {
    "node": ">=20.17.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.62.0",
    "@dotenvx/dotenvx": "^1.51.0",
    "apicache": "^1.6.3",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-slow-down": "^3.0.0",
    "express-validator": "^7.2.1",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^3.0.5",
    "i18next": "^23.7.6",
    "i18next-fs-backend": "^2.3.1",
    "i18next-http-middleware": "^3.5.0",
    "jsonwebtoken": "^9.0.2",
    "memory-cache": "^0.2.0",
    "moment": "^2.29.4",
    "mongodb": "^6.19.0",
    "mongoose": "^8.18.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.6",
    "qrcode": "^1.5.4",
    "redis": "^4.7.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.7.4",
    "sql.js": "^1.13.0",
    "web3": "^4.16.0",
    "winston": "^3.11.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.3",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
