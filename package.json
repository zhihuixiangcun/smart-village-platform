{
  "name": "smart-village-platform",
  "version": "1.0.0",
  "description": "智慧乡村综合服务平台 - 涵盖村民管理、村务治理、信息公示、生活服务四大核心模块",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "test:residents": "NODE_ENV=test jest test-resident-module.js",
    "test:comprehensive": "NODE_ENV=test jest --config tests/jest.config.comprehensive.js",
    "test:performance": "NODE_ENV=test jest --config jest.config.performance.js",
    "test:security": "NODE_ENV=test jest --config jest.security.config.json",
    "verify:residents": "node run-resident-tests.js",
    "lint": "eslint src/ --fix",
    "lint:client": "cd client && npm run lint",
    "format": "prettier --write \"src/**/*.js\" \"server/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"server/**/*.js\" \"tests/**/*.js\"",
    "format:client": "cd client && npm run format",
    "code-quality": "npm run lint && npm run format:check",
    "init": "npm install && npm run setup",
    "setup": "node scripts/setup.js",
    "init-db": "node scripts/init-db.js",
    "init-db-sqlite": "node scripts/init-db-sqlite.js",
    "health-check": "node -e \"console.log('Node.js:', process.version); console.log('Platform:', process.platform);\"",
    "security:audit": "node scripts/security-audit.js",
    "security:test": "jest tests/security/ --detectOpenHandles",
    "performance:test": "artillery run tests/performance/load-test.yml",
    "optimize:performance": "node scripts/performance-optimization.js",
    "dev:servers": "node scripts/dev-servers.js",
    "start:servers": "node scripts/start-servers.js",
    "database:start": "node scripts/start-database.js",
    "database:stop": "docker-compose -f docker-compose.dev.yml down",
    "database:status": "docker-compose -f docker-compose.dev.yml ps",
    "database:reset": "docker-compose -f docker-compose.dev.yml down -v && node scripts/start-database.js",
    "database:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "setup:database": "npm run database:start && npm run init-db",
    "test:report": "npm run test:comprehensive && npm run test:performance && npm run security:test",
    "coverage:report": "open coverage/comprehensive/lcov-report/index.html",
    "performance:benchmark": "npx jest tests/performance/ --maxWorkers=1",
    "performance:api": "npx jest tests/performance/api-benchmark.test.js --maxWorkers=1",
    "performance:service": "npx jest tests/performance/service-benchmark.test.js --maxWorkers=1",
    "performance:report": "node tests/performance/generate-report.js"
  },
  "keywords": [
    "smart-village",
    "rural-services",
    "express",
    "vue",
    "nodejs",
    "智慧乡村"
  ],
  "author": "admin",
  "license": "ISC",
  "engines": {
    "node": ">=20.17.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.62.0",
    "@dotenvx/dotenvx": "^1.51.0",
    "@tensorflow/tfjs": "^4.20.0",
    "@tensorflow/tfjs-node": "^4.20.0",
    "accesscontrol": "^2.2.1",
    "apicache": "^1.6.3",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "bpmn-engine": "^24.0.1",
    "casbin": "^5.28.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-slow-down": "^3.0.0",
    "express-validator": "^7.2.1",
    "face-api.js": "^0.22.2",
    "faker": "^6.6.6",
    "helmet": "^7.2.0",
    "http-proxy-middleware": "^3.0.5",
    "i18next": "^23.16.8",
    "i18next-fs-backend": "^2.6.0",
    "i18next-http-middleware": "^3.8.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^10.0.0",
    "memory-cache": "^0.2.0",
    "moment": "^2.30.1",
    "mongodb": "^6.19.0",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.2",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.6",
    "qrcode": "^1.5.4",
    "redis": "^4.7.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.1",
    "sql.js": "^1.13.0",
    "tesseract.js": "^5.1.1",
    "validator": "^13.15.23",
    "web3": "^4.16.0",
    "winston": "^3.17.0",
    "workbox-webpack-plugin": "^7.1.0",
    "ws": "^8.18.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "mongodb-memory-server": "^9.1.3",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
