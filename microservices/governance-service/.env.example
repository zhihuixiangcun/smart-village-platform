# 服务配置
NODE_ENV=development
PORT=5002
HOSTNAME=localhost

# 数据库配置
MONGO_URI=mongodb://localhost:27017/governance_db

# JWT配置
JWT_SECRET=your-governance-jwt-secret-key

# 客户端配置
CLIENT_URL=http://localhost:3000

# 服务发现配置
CONSUL_HOST=localhost
CONSUL_PORT=8500
SERVICE_HOST=localhost

# RabbitMQ配置
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# 日志配置
LOG_LEVEL=info

# 文件上传配置
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=./uploads

# 邮件服务配置
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@smartvillage.com
SMTP_PASS=your-smtp-password

# 短信服务配置
SMS_ACCESS_KEY=your-sms-access-key
SMS_SECRET_KEY=your-sms-secret-key

# 微信服务配置
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# Redis缓存配置（可选）
REDIS_URL=redis://localhost:6379

# 对象存储配置（可选）
OSS_ACCESS_KEY=your-oss-access-key
OSS_SECRET_KEY=your-oss-secret-key
OSS_BUCKET=smart-village-files
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com