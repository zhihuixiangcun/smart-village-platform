{
  "name": "smart-village-api-gateway",
  "version": "1.0.0",
  "description": "智慧乡村平台API网关 - 统一入口、路由、负载均衡、熔断器、限流等功能",
  "main": "SmartVillageAPIGateway.js",
  "scripts": {
    "start": "node SmartVillageAPIGateway.js",
    "dev": "nodemon SmartVillageAPIGateway.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "health-check": "curl -f http://localhost:8080/health || exit 1"
  },
  "keywords": [
    "smart-village",
    "api-gateway",
    "microservices",
    "load-balancing",
    "circuit-breaker",
    "rate-limiting"
  ],
  "author": "Smart Village Development Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "opossum": "^7.1.0",
    "redis": "^4.6.7",
    "winston": "^3.10.0",
    "express-rate-limit": "^6.8.1",
    "helmet": "^7.0.0",
    "uuid": "^9.0.0",
    "node-fetch": "^3.3.2",
    "dotenv": "^16.3.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.1",
    "supertest": "^6.3.3",
    "eslint": "^8.45.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^16.0.1",
    "eslint-plugin-promise": "^6.1.1",
    "@types/jest": "^29.5.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!coverage/**",
      "!jest.config.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/__tests__/**/*.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "eslintConfig": {
    "extends": "standard",
    "env": {
      "node": true,
      "jest": true
    },
    "rules": {
      "no-console": "off"
    }
  }
}