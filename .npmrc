# npm 安全配置
# 智慧乡村平台 - 增强包管理和审计安全

# ========== 审计配置 ==========
# 设置审计级别为高，确保检测到所有高危和中危漏洞
audit-level=high

# 禁用自动审计跳过，确保所有漏洞都被报告
audit=false

# ========== 依赖安装配置 ==========
# 不跳过可选依赖，确保完整性
ignore-optional=false

# 严格的对等依赖解析
strict-peer-dependencies=false

# ========== 脚本执行配置 ==========
# 不忽略脚本，确保所有生命周期脚本被执行
# 注意：设置为 false 可能会影响某些包的安装，但能提高安全性
ignore-scripts=false

# ========== 注册表配置 ==========
# 使用官方 npm 注册表（生产环境建议）
# registry=https://registry.npmjs.org/

# 如需使用镜像，请取消注释并确保镜像支持审计功能
# registry=https://registry.npmmirror.com

# ========== 引擎检查 ==========
# 强制 Node.js 版本检查
engine-strict=true

# ========== 锁文件配置 ==========
# 保留锁文件以确保依赖一致性
package-lock=true

# ========== 安全注意事项 ==========
# 1. 定期运行 npm audit 检查安全更新
# 2. 使用 npm outdated 检查过时的包
# 3. 在 CI/CD 流程中集成 npm audit
# 4. 对于已知的安全漏洞，考虑使用 overrides 或 resolutions
# ========== 知名漏洞包覆盖配置 ==========
# 由于 face-api.js 的依赖存在已知漏洞，但暂时保留使用
# 当安全版本可用时，应及时更新

# 监控以下包的安全更新：
# - face-api.js (tensorflow 依赖)
# - node-fetch (传递依赖)

# ========== CI/CD 集成建议 ==========
# 在 package.json 中添加：
# "scripts": {
#   "audit:fix": "npm audit fix",
#   "audit:check": "npm audit --audit-level=high",
#   "preinstall": "npx npm-force-resolutions"
# }