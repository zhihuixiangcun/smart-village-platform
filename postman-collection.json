  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 设置全局时间戳",
          "pm.globals.set('timestamp', Date.now());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 全局测试脚本",
          "pm.test('响应状态码正常', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204, 400, 401, 403, 404]);",
          "});",
          "",
          "pm.test('响应时间小于5秒', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "// 如果是登录接口且成功，保存token",
          "if (pm.request.url.path.includes('login') && pm.response.code === 200) {",
          "    var responseJson = pm.response.json();",
          "    if (responseJson.token) {",
          "        pm.globals.set('authToken', responseJson.token);",
          "    }",
          "}"
        ]
      }
    }
  ]
