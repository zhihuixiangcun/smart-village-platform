# 智慧乡村 API 服务器 - Node 20 优化版
FROM node:20-alpine AS builder
RUN apk add --no-cache python3 make g++ git
WORKDIR /app
COPY package*.json ./
RUN npm config set registry https://registry.npmmirror.com && npm ci --only=production

FROM node:20-alpine AS production
RUN apk add --no-cache dumb-init curl && rm -rf /var/cache/apk/*
RUN addgroup -g 1001 -S nodejs && adduser -S smartvillage -u 1001
WORKDIR /app
COPY --from=builder --chown=smartvillage:nodejs /app/node_modules ./node_modules
COPY --chown=smartvillage:nodejs package*.json ./ src ./src server ./server
RUN mkdir -p /app/uploads /app/logs && chown -R smartvillage:nodejs /app/uploads /app/logs
ENV NODE_ENV=production PORT=3001 NODE_OPTIONS="--max-old-space-size=2048"
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 CMD curl -f http://localhost:3001/api/v1/health || exit 1
EXPOSE 3001
USER smartvillage
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "src/app.js"]
