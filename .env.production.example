# 智慧乡村综合服务平台 - 生产环境配置示例
# 复制此文件为 .env.production 并填入实际值

# 数据库配置
MONGODB_URI=mongodb://smart_village:your_password@mongodb:27017/smart_village
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_mongo_password

# Redis配置
REDIS_PASSWORD=your_redis_password

# 应用配置
NODE_ENV=production
PORT=3001
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# 前端域名
CLIENT_URL=https://your-domain.com

# 第三方服务配置
BAIDU_TTS_KEY=your_baidu_tts_api_key
TENCENT_OCR_KEY=your_tencent_ocr_api_key

# 加密配置
ENCRYPTION_KEY_ROTATION_INTERVAL=2592000000

# 缓存配置
CACHE_TTL_L1=300000
CACHE_TTL_L2=900000
CACHE_TTL_L3=3600000

# 安全配置
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret

# 监控配置
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_grafana_password

# 邮件配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# 备份配置
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# 限流配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# SSL配置
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/ssl/private.key

# 性能配置
MAX_CONNECTIONS=1000
CONNECTION_TIMEOUT=30000

# 微信小程序配置
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret