# ============================================
# 智慧乡村综合服务平台 - 生产环境配置示例
# ============================================
# 警告: 请勿将包含真实密钥的此文件提交到版本控制系统
# 使用方法: 复制此文件为 .env.production 并填入实际值
# 最后更新: 2025-12-30
# ============================================

# ============================================
# 应用基础配置
# ============================================
NODE_ENV=production
MAIN_PORT=3001
VILLAGE_SERVER_PORT=5000

# 前端应用URL (生产域名)
CLIENT_URL=https://your-domain.com

# 应用域名配置
DOMAIN=your-domain.com
API_DOMAIN=api.your-domain.com

# ============================================
# 数据库配置
# ============================================
# MongoDB 生产连接 (副本集模式推荐)
MONGO_URI=mongodb://smart_village:your_password@mongodb-primary:27017,mongodb-secondary:27017,mongodb-arbiter:27017/smart_village?authSource=admin&replicaSet=rs0&readPreference=primaryPreferred&ssl=true
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_mongo_root_password_change_this

# MongoDB 连接池配置 (优化生产性能)
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_CONNECT_TIMEOUT_MS=10000

# ============================================
# Redis 缓存配置
# ============================================
REDIS_HOST=redis-cluster
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_change_this
REDIS_DB=0
REDIS_TLS=true

# Redis 连接池
REDIS_MAX_RETRIES_PER_REQUEST=3
REDIS_RETRY_STRATEGY=delay
REDIS_RETRY_DELAY_ON_FAILOVER=100

# ============================================
# JWT 认证配置
# ============================================
# 警告: 生产环境必须使用强随机密钥 (至少 32 字符)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# JWT 算法 (推荐 RS256 用于生产环境)
JWT_ALGORITHM=RS256
# JWT_PUBLIC_KEY=/path/to/public.key
# JWT_PRIVATE_KEY=/path/to/private.key

# ============================================
# HTTPS & SSL 配置
# ============================================
SSL_CERT_PATH=/etc/ssl/certs/your-domain.crt
SSL_KEY_PATH=/etc/ssl/private/your-domain.key
SSL_CA_PATH=/etc/ssl/certs/ca-bundle.crt

# ============================================
# AI 服务配置
# ============================================

# 百度语音合成 (TTS)
BAIDU_TTS_APP_ID=your_baidu_app_id
BAIDU_TTS_API_KEY=your_baidu_api_key
BAIDU_TTS_SECRET_KEY=your_baidu_secret_key
BAIDU_TTS_ENDPOINT=https://tsn.baidu.com/text2audio

# 百度语音识别 (ASR)
BAIDU_ASR_APP_ID=your_baidu_asr_app_id
BAIDU_ASR_API_KEY=your_baidu_asr_api_key
BAIDU_ASR_SECRET_KEY=your_baidu_asr_secret_key
BAIDU_ASR_ENDPOINT=https://vop.baidu.com/server_api

# 腾讯云 OCR
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_REGION=ap-shanghai
TENCENT_OCR_ENDPOINT=https://ocr.tencentcloudapi.com

# 腾讯云人脸识别
TENCENT_FACE_SECRET_ID=your_tencent_face_secret_id
TENCENT_FACE_SECRET_KEY=your_tencent_face_secret_key
TENCENT_FACE_REGION=ap-shanghai
TENCENT_FACE_ENDPOINT=https://iai.tencentcloudapi.com

# ============================================
# 通信服务配置
# ============================================

# 短信服务 (阿里云/腾讯云)
SMS_ACCESS_KEY_ID=your_sms_access_key
SMS_ACCESS_KEY_SECRET=your_sms_secret
SMS_SIGN_NAME=智慧乡村
SMS_TEMPLATE_CODE=SMS_123456789
SMS_ENDPOINT=dysmsapi.aliyuncs.com

# 邮件服务
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=智慧乡村平台 <noreply@your-domain.com>

# ============================================
# 文件存储配置
# ============================================

# 本地上传路径 (生产环境建议使用对象存储服务)
UPLOAD_PATH=/var/www/smart-village/uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# 对象存储 (推荐阿里云OSS/AWS S3)
OSS_REGION=oss-cn-shanghai
OSS_ACCESS_KEY_ID=your_oss_access_key
OSS_ACCESS_KEY_SECRET=your_oss_secret
OSS_BUCKET=smart-village-prod
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/smart-village
LOG_FORMAT=json
LOG_MAX_SIZE=50m
LOG_MAX_FILES=30

# ============================================
# 监控 & 性能配置
# ============================================

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_grafana_password_change_this
GRAFANA_URL=http://grafana:3000

# 应用性能监控 (APM)
APM_SERVICE_NAME=smart-village-platform
APM_SERVER_URL=https://apm-server.example.com:8200
APM_SECRET_TOKEN=your-apm-token

# Prometheus 指标
METRICS_ENABLED=true
METRICS_PORT=9090

# 健康检查
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# ============================================
# 安全配置
# ============================================

# 速率限制
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL=false

# CORS 配置
CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With,X-User-Id,X-Village-Id

# Helmet 安全头
HELMET_CSP_ENABLED=true
HELMET_HSTS_ENABLED=true
HELMET_HSTS_MAX_AGE=31536000

# 加密配置
ENCRYPTION_KEY_ROTATION_INTERVAL=2592000000
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_min_32_chars

# ============================================
# 会话 & Cookie 配置
# ============================================
SESSION_MAX_AGE=86400000
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=.your-domain.com

# ============================================
# 缓存配置
# ============================================
CACHE_TTL_L1=300000
CACHE_TTL_L2=900000
CACHE_TTL_L3=3600000

# ============================================
# 备份 & 灾难恢复
# ============================================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=smart-village-backups

# ============================================
# 性能配置
# ============================================
MAX_CONNECTIONS=1000
CONNECTION_TIMEOUT=30000
MAX_BODY_SIZE=1mb
MAX_URL_ENCODED_SIZE=1mb

# ============================================
# 第三方服务集成
# ============================================

# 支付服务 (支付宝/微信支付)
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key

WECHAT_PAY_MCH_ID=your_wechat_mch_id
WECHAT_PAY_API_KEY=your_wechat_api_key
WECHAT_PAY_CERT_PATH=/path/to/cert.pem

# 政务服务平台对接
GOV_API_KEY=your_gov_api_key
GOV_API_SECRET=your_gov_api_secret
GOV_API_ENDPOINT=https://api.gov.example.com

# ============================================
# 微信小程序配置
# ============================================
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# ============================================
# 区块链配置 (可选)
# ============================================
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK=mainnet
BLOCKCHAIN_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
BLOCKCHAIN_CONTRACT_ADDRESS=0x...

# ============================================
# 功能开关
# ============================================
FEATURE_REALTIME_ENGINE=true
FEATURE_AI_CHAT=true
FEATURE_FACE_RECOGNITION=true
FEATURE_VOICE_INTERACTION=true
FEATURE_BLOCKCHAIN=false
FEATURE_ECOMMERCE=true

# ============================================
# 部署环境标识
# ============================================
DEPLOYMENT_ENV=production
DEPLOYMENT_VERSION=1.0.0
DEPLOYMENT_TIMESTAMP=2025-12-30T00:00:00Z

# ============================================
# 开发/调试选项 (生产环境设为 false)
# ============================================
DEBUG=false
VERBOSE_LOGGING=false
PROFILING_ENABLED=false
STACK_TRACE_ENABLED=false