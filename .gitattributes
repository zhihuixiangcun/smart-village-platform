# 智慧乡村平台 - Git 属性配置
# 统一换行符处理，避免 LF/CRLF 混合问题

# 默认所有文本文件使用 LF
* text=auto eol=lf

# Windows 特定文件使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 源代码文件（强制 LF）
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 配置文件
.* text eol=lf
*.env.* text eol=lf
*.config.js text eol=lf

# 二进制文件（不处理换行符）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.exe binary

# 特殊文件
*.patch text eol=lf
*.diff text eol=lf
