# Grafana 智慧乡村平台监控面板配置
{
  "dashboard": {
    "id": null,
    "title": "智慧乡村综合服务平台 - 系统概览",
    "tags": ["smart-village", "overview", "production"],
    "style": "dark",
    "timezone": "browser",
    "editable": true,
    "hideControls": false,
    "graphTooltip": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "系统健康状态概览",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=~\"smart-village-.*\"}",
            "legendFormat": "{{job}} - {{instance}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {"options": {"0": {"text": "离线"}}, "type": "value"},
              {"options": {"1": {"text": "在线"}}, "type": "value"}
            ]
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "API 请求速率 (请求/秒)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"smart-village-api\"}[5m])",
            "legendFormat": "{{method}} {{handler}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "请求/秒", "min": 0},
          {"show": false}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "API 响应时间分布",
        "type": "graph", 
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"smart-village-api\"}[5m]))",
            "legendFormat": "50%分位",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"smart-village-api\"}[5m]))",
            "legendFormat": "95%分位", 
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"smart-village-api\"}[5m]))",
            "legendFormat": "99%分位",
            "refId": "C"
          }
        ],
        "yAxes": [
          {"label": "响应时间 (秒)", "min": 0},
          {"show": false}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 18, "y": 0}
      },
      {
        "id": 4,
        "title": "HTTP 状态码分布",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (status) (rate(http_requests_total{job=\"smart-village-api\"}[5m]))",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8}
      },
      {
        "id": 5,
        "title": "容器CPU使用率 (%)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{pod=~\"api-server-.*|village-server-.*|client-.*\"}[5m]) * 100",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "CPU使用率 (%)", "min": 0, "max": 100},
          {"show": false}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 8}
      },
      {
        "id": 6,
        "title": "容器内存使用率 (%)",
        "type": "graph",
        "targets": [
          {
            "expr": "container_memory_usage_bytes{pod=~\"api-server-.*|village-server-.*|client-.*\"} / container_spec_memory_limit_bytes{pod=~\"api-server-.*|village-server-.*|client-.*\"} * 100",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "内存使用率 (%)", "min": 0, "max": 100},
          {"show": false}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 18, "y": 8}
      },
      {
        "id": 7,
        "title": "数据库连接状态",
        "type": "stat",
        "targets": [
          {
            "expr": "mongodb_connections{state=\"current\"}",
            "legendFormat": "MongoDB 当前连接",
            "refId": "A"
          },
          {
            "expr": "redis_connected_clients",
            "legendFormat": "Redis 连接数",
            "refId": "B"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16}
      },
      {
        "id": 8,
        "title": "WebSocket 连接数",
        "type": "graph",
        "targets": [
          {
            "expr": "websocket_connections_total{job=\"smart-village-server\"}",
            "legendFormat": "活跃WebSocket连接",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "连接数", "min": 0},
          {"show": false}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 16}
      },
      {
        "id": 9,
        "title": "存储使用情况",
        "type": "graph",
        "targets": [
          {
            "expr": "(node_filesystem_size_bytes{mountpoint=\"/\"} - node_filesystem_avail_bytes{mountpoint=\"/\"}) / node_filesystem_size_bytes{mountpoint=\"/\"} * 100",
            "legendFormat": "{{instance}} 磁盘使用率",
            "refId": "A"
          }
        ],
        "yAxes": [
          {"label": "使用率 (%)", "min": 0, "max": 100},
          {"show": false}
        ],
        "gridPos": {"h": 8, "w": 12, "x": 18, "y": 16}
      },
      {
        "id": 10,
        "title": "网络流量",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[5m])",
            "legendFormat": "{{instance}} 接收",
            "refId": "A"
          },
          {
            "expr": "rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m])",
            "legendFormat": "{{instance}} 发送",
            "refId": "B"
          }
        ],
        "yAxes": [
          {"label": "字节/秒", "min": 0},
          {"show": false}
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}
      }
    ],
    "annotations": {
      "list": [
        {
          "name": "部署事件",
          "datasource": "prometheus",
          "enable": true,
          "expr": "changes(up{job=~\"smart-village-.*\"}[5m]) > 0",
          "iconColor": "green",
          "titleFormat": "服务重启",
          "textFormat": "{{job}} 在 {{instance}} 上重启"
        }
      ]
    },
    "templating": {
      "list": [
        {
          "name": "instance",
          "type": "query",
          "query": "label_values(up{job=~\"smart-village-.*\"}, instance)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        }
      ]
    }
  }
}