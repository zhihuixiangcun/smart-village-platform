# ============================================
# 智慧乡村平台 - 生产环境 Dockerfile
# ============================================

# 阶段1: 基础镜像
FROM node:20-alpine AS base

# 安装系统依赖
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    cairo-dev \
    jpeg-dev \
    pango-dev \
    giflib-dev \
    pixman-dev \
    pkgconfig \
    curl

# 设置工作目录
WORKDIR /app

# ============================================
# 阶段2: 依赖安装
# ============================================

FROM base AS dependencies

# 复制 package 文件
COPY package*.json ./

# 安装生产依赖（canvas 可选）
RUN npm ci --only=production && \
    npm cache clean --force

# ============================================
# 阶段3: 构建阶段
# ============================================

FROM dependencies AS build

# 安装所有依赖（包括 devDependencies）
COPY package*.json ./
RUN npm ci

# 复制源代码
COPY src/ ./src/
COPY server/ ./server/

# 构建 TypeScript/转译代码（如需要）
# RUN npm run build

# ============================================
# 阶段4: 认证服务
# ============================================

FROM build AS auth-service

EXPOSE 3001

ENV NODE_ENV=production \
    PORT=3001

CMD ["node", "src/app.js"]

# ============================================
# 阶段5: 村务服务
# ============================================

FROM build AS village-service

EXPOSE 5000

ENV NODE_ENV=production \
    PORT=5000

CMD ["node", "server/app.js"]

# ============================================
# 阶段6: 监控服务
# ============================================

FROM build AS monitoring-service

EXPOSE 3099

ENV NODE_ENV=production \
    MONITORING_PORT=3099

CMD ["node", "src/app-unified.js"]
