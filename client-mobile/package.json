  "author": "Smart Village Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.7",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-i18n": "^9.9.1",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/ui": "^4.0.17",
    "@vue/test-utils": "^2.4.5",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.22.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "prettier": "^3.3.3",
    "sass": "^1.71.1",
    "tailwindcss": "^3.4.1",
    "vite": "^7.3.1",
