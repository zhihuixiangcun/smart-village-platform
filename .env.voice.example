# 智慧乡村语音交互系统环境配置
# 复制此文件为 .env 并填入实际配置值

# ===========================================
# 基础服务配置
# ===========================================

# 主服务端口
NODE_ENV=development
MAIN_PORT=3001

# Python语音服务端口
VOICE_SERVICE_PORT=5001
VOICE_SERVICE_HOST=localhost

# ===========================================
# 百度语音API配置
# ===========================================
# 请在百度AI开放平台申请语音识别和语音合成服务
# https://ai.baidu.com/tech/speech

BAIDU_APP_ID=your_baidu_app_id
BAIDU_API_KEY=your_baidu_api_key
BAIDU_SECRET_KEY=your_baidu_secret_key

# ===========================================
# 备用语音服务配置（可选）
# ===========================================

# 腾讯云语音服务
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key

# 阿里云语音服务
ALI_ACCESS_KEY_ID=your_ali_access_key_id
ALI_ACCESS_KEY_SECRET=your_ali_access_key_secret

# ===========================================
# 数据库配置
# ===========================================

# MongoDB配置
MONGO_URI=mongodb://localhost:27017/smart_village
MONGO_TEST_URI=mongodb://localhost:27017/smart_village_test

# Redis配置（用于缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===========================================
# 语音处理配置
# ===========================================

# 音频处理参数
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_BIT_DEPTH=16
AUDIO_FORMAT=wav
AUDIO_MAX_DURATION=60
AUDIO_SILENCE_THRESHOLD=0.01
AUDIO_SILENCE_DURATION=2.0

# 语音识别配置
SPEECH_RECOGNITION_ENGINE=baidu  # baidu, whisper, azure
SPEECH_RECOGNITION_LANGUAGE=zh-CN
SPEECH_RECOGNITION_DIALECT=auto

# 语音合成配置
TTS_ENGINE=baidu  # baidu, azure, web
TTS_DEFAULT_VOICE=female
TTS_DEFAULT_LANGUAGE=zh-CN
TTS_SPEED=1.0
TTS_PITCH=1.0
TTS_VOLUME=1.0
TTS_EMOTION=neutral

# ===========================================
# 方言支持配置
# ===========================================

# 支持的方言列表（用逗号分隔）
SUPPORTED_DIALECTS=zh,yue,nan,hak,wuu,hsn,gan,zh-northeast,zh-sichuan,zh-chongqing,zh-shaanxi,zh-shandong,zh-henan,zh-hubei,zh-jiangzhe,zh-anhui,zh-hebei,zh-shanxi,zh-neimeng,zh-gansu,zh-ningxia,zh-xinjiang,zh-xizang,zh-qinghai

# 默认方言
DEFAULT_DIALECT=zh

# ===========================================
# 语音命令配置
# ===========================================

# 唤醒词列表（用逗号分隔）
WAKE_WORDS=小智,村小助手,智慧乡村,村民助手

# 命令识别配置
COMMAND_CONFIDENCE_THRESHOLD=0.6
COMMAND_TIMEOUT=5.0
COMMAND_MAX_RETRIES=3

# ===========================================
# 缓存配置
# ===========================================

# 语音识别结果缓存
ENABLE_CACHE=true
CACHE_TYPE=memory  # memory, redis
CACHE_MAX_SIZE=1000
CACHE_TTL=3600

# ===========================================
# 性能配置
# ===========================================

# 并发处理配置
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30
QUEUE_SIZE=100
WORKER_PROCESSES=1

# ===========================================
# 安全配置
# ===========================================

# CORS配置
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5000

# 文件上传配置
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_AUDIO_FORMATS=wav,mp3,webm,ogg

# 速率限制
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ===========================================
# 日志配置
# ===========================================

# 日志级别
LOG_LEVEL=info  # debug, info, warn, error

# 日志文件配置
LOG_FILE=logs/voice_service.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# ===========================================
# 监控配置
# ===========================================

# 监控端口
MONITORING_PORT=9001

# 健康检查配置
HEALTH_CHECK_INTERVAL=30
PERFORMANCE_TRACKING=true
ERROR_TRACKING=true

# ===========================================
# 消息通知配置（可选）
# ===========================================

# 短信服务配置
SMS_PROVIDER=aliyun  # aliyun, tencent
SMS_ACCESS_KEY=your_sms_access_key
SMS_SECRET_KEY=your_sms_secret_key

# 邮件服务配置
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=noreply@smartvillage.com
EMAIL_PASS=your_email_password

# ===========================================
# 存储配置
# ===========================================

# 文件存储路径
UPLOAD_PATH=./uploads
TEMP_PATH=./temp
MODEL_PATH=./models

# 云存储配置（可选）
# OSS_ACCESS_KEY_ID=your_oss_access_key_id
# OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
# OSS_BUCKET=smart-village-audio
# OSS_REGION=oss-cn-hangzhou

# ===========================================
# 开发调试配置
# ===========================================

# 调试模式
DEBUG=false
VERBOSE_LOGGING=false

# 热重载
HOT_RELOAD=true

# 开发工具端口
DEV_TOOLS_PORT=9229