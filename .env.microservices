# 智慧乡村平台 - 环境配置文件

# =====================================
# 基础配置
# =====================================

NODE_ENV=development
SERVICE_VERSION=1.0.0

# =====================================
# 数据库配置
# =====================================

# MongoDB配置
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=smartvillage2024!
MONGO_DATABASE=smart_village

# MongoDB连接池配置
MONGO_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2
MONGO_IDLE_TIME=30000
MONGO_SELECT_TIMEOUT=5000
MONGO_SOCKET_TIMEOUT=45000
MONGO_CONNECT_TIMEOUT=10000

# Redis配置
REDIS_PASSWORD=redis2024!
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=5000
REDIS_KEEPALIVE=30000
REDIS_RETRY_DELAY=100
REDIS_CLUSTER_RETRY=100
REDIS_MAX_RETRIES=3
REDIS_LOADING_TIMEOUT=2000

# =====================================
# 服务端口配置
# =====================================

GATEWAY_PORT=8080
AUTH_PORT=3001
VILLAGE_PORT=5000
MONITORING_PORT=3099
CLIENT_PORT=3000

# =====================================
# JWT认证配置
# =====================================

JWT_SECRET=smartvillage_jwt_secret_2024_super_secure_key
JWT_REFRESH_SECRET=smartvillage_refresh_secret_2024_ultra_secure
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# =====================================
# API配置
# =====================================

API_BASE_URL=http://localhost:8080/api/v1
CLIENT_URL=http://localhost:3000
WS_URL=ws://localhost:8080

# 服务间通信URL
AUTH_SERVICE_URL=http://localhost:3001
VILLAGE_SERVICE_URL=http://localhost:5000
MONITORING_SERVICE_URL=http://localhost:3099

# =====================================
# 管理界面配置
# =====================================

# Redis管理界面
REDIS_UI_USER=admin
REDIS_UI_PASSWORD=admin123

# MongoDB管理界面
MONGO_UI_USER=admin
MONGO_UI_PASSWORD=admin123

# =====================================
# 日志配置
# =====================================

LOG_LEVEL=info
LOG_FILE_PATH=./logs

# =====================================
# 文件上传配置
# =====================================

UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# =====================================
# 外部服务配置 (可选)
# =====================================

# 短信服务
SMS_ACCESS_KEY_ID=your_sms_access_key
SMS_ACCESS_KEY_SECRET=your_sms_secret
SMS_SIGN_NAME=智慧乡村
SMS_TEMPLATE_CODE=SMS_123456789

# 百度语音合成
BAIDU_TTS_APP_ID=your_baidu_app_id
BAIDU_TTS_API_KEY=your_baidu_api_key
BAIDU_TTS_SECRET_KEY=your_baidu_secret_key

# 腾讯云OCR
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_REGION=ap-beijing

# =====================================
# 监控配置
# =====================================

# 性能监控阈值
SLOW_REQUEST_THRESHOLD=1000
MEMORY_USAGE_THRESHOLD=80
CPU_USAGE_THRESHOLD=80

# 健康检查间隔
HEALTH_CHECK_INTERVAL=30000

# =====================================
# 安全配置
# =====================================

# CORS配置
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# 限流配置
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
STRICT_RATE_LIMIT_MAX=10

# 账号安全
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=1800000

# =====================================
# 缓存配置
# =====================================

# 缓存TTL (秒)
CACHE_USER_SESSION=1800
CACHE_ANNOUNCEMENTS=600
CACHE_RESIDENTS_LIST=300
CACHE_VILLAGE_STATS=3600
CACHE_SYSTEM_CONFIG=86400